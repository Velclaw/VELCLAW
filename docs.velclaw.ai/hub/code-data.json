{
  "schemaVersion": "1.0.0",
  "repositories": [
    {
      "fullName": "Velclaw/Velclaw",
      "visibility": "private",
      "description": "Hệ thống lõi Velclaw",
      "defaultBranch": "main",
      "access": "github-authenticated"
    },
    {
      "fullName": "Velclaw/velclaw.cfd/docs",
      "visibility": "private",
      "description": "Docs và VelclawHub",
      "defaultBranch": "main",
      "access": "github-authenticated"
    }
  ],
  "integration": {
    "provider": "github",
    "mode": "user-token",
    "next": ["repository", "branch", "tree", "file", "diff", "commit", "pull-request"]
  }
}
