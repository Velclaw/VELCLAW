<!-- velclaw brand identity system -->
<style>
  #vc-root {
    --graphite: #0B0D10;
    --panel: #14181D;
    --panel2: #1A1F26;
    --line: #262C34;
    --ink: #E9EDF0;
    --ink-dim: #8B94A0;
    --ocean: #4A7FA8;
    --cyan: #9FE3F0;
    --cyan-dim: #6FB9CC;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--graphite);
    color: var(--ink);
    padding: 48px 32px 80px;
    border-radius: 16px;
    line-height: 1.5;
  }
  #vc-root * { box-sizing: border-box; }
  .vc-section { max-width: 1080px; margin: 0 auto 64px; }
  .vc-eyebrow {
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--cyan-dim); font-weight: 600; margin-bottom: 10px;
  }
  .vc-h1 {
    font-size: 30px; font-weight: 650; letter-spacing: -0.02em; margin: 0 0 6px;
  }
  .vc-sub { color: var(--ink-dim); font-size: 14px; margin: 0 0 28px; max-width: 640px; }
  .vc-grid { display: grid; gap: 16px; }
  .vc-grid-2 { grid-template-columns: 1fr 1fr; }
  .vc-grid-4 { grid-template-columns: repeat(4, 1fr); }
  .vc-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 28px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 16px;
    min-height: 180px;
  }
  .vc-card.light { background: #F3F5F7; border-color: #E2E6EA; }
  .vc-label {
    font-size: 11px; color: var(--ink-dim); letter-spacing: 0.06em;
    text-transform: uppercase; text-align: center;
  }
  .vc-card.light .vc-label { color: #6B7280; }
  .vc-swatches { display: flex; gap: 12px; flex-wrap: wrap; }
  .vc-swatch { flex: 1; min-width: 140px; border-radius: 10px; overflow: hidden; border: 1px solid var(--line); }
  .vc-swatch-color { height: 64px; }
  .vc-swatch-meta { padding: 10px 12px; background: var(--panel); font-size: 12px; }
  .vc-swatch-name { font-weight: 600; color: var(--ink); }
  .vc-swatch-hex { color: var(--ink-dim); font-family: 'SF Mono', Consolas, monospace; margin-top: 2px; }
  .vc-row-sizes { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; padding: 24px; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; }
  .vc-size-item { display: flex; flex-direction: column; align-items: center; gap: 8px; }
</style>

