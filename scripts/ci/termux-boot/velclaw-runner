#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

# Termux:Boot executes this file after Android boots. It deliberately starts
# only the GitHub Actions runner; no Velclaw server, database, Docker runtime,
# or persistent project workload is started on the phone.

STATE_DIR="$HOME/.velclaw-runner"
LOG_FILE="$STATE_DIR/boot.log"
mkdir -p "$STATE_DIR"

REPO_DIR="${VELCLAW_REPO_DIR:-$HOME/velclaw}"
LAUNCHER="$REPO_DIR/scripts/ci/start-termux-github-runner.sh"

if [ ! -x "$LAUNCHER" ]; then
  echo "Velclaw runner launcher not found: $LAUNCHER" >>"$LOG_FILE"
  exit 1
fi

# Start detached so no Termux terminal window needs to remain open.
nohup "$LAUNCHER" >>"$LOG_FILE" 2>&1 </dev/null &
