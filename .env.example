# Velclaw domain registry
# Keep domain identity in deployment configuration. Do not hard-code a TLD in source.
# For local development, the domain-config module defaults to http://localhost:3000.

VELCLAW_PUBLIC_ORIGIN=http://localhost:3000
VELCLAW_OAUTH_ISSUER=http://localhost:3000
VELCLAW_APP_ORIGIN=http://localhost:3000
VELCLAW_API_ORIGIN=http://localhost:3000
VELCLAW_DOCS_ORIGIN=http://localhost:3000
VELCLAW_ALLOWED_ORIGINS=http://localhost:3000

# Runtime publisher / self-hosted deployment
# Set these only in the deployment environment that owns the public hostname.
VELCLAW_PUBLIC_DOMAIN=localhost
VELCLAW_PUBLIC_SCHEME=http
VELCLAW_TLS_EMAIL=

# Required application secrets
VELCLAW_OAUTH_SECRET=
POSTGRES_URL=
JWE_SECRET=
ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_AGENTS_MODEL=gpt-4.1-mini

# S3-compatible storage. Generate credentials in the storage provider; never commit them.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# MCP server credentials (never commit real values)
GITHUB_MCP_PAT=
CONTEXT7_API_KEY=
RECALL_PRIVATE_KEY=
RECALL_NETWORK=testnet
RECALL_BUCKET_ALIAS=sequential-thinking-logs
RECALL_LOG_PREFIX=sequential-
