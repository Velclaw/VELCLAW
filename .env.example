# Velclaw production domain configuration
# Public web application
VELCLAW_PUBLIC_ORIGIN=https://velclaw.app
VELCLAW_OAUTH_ISSUER=https://velclaw.app
VELCLAW_APP_ORIGIN=https://velclaw.app
VELCLAW_API_ORIGIN=https://velclaw.app
VELCLAW_DOCS_ORIGIN=https://velclaw.app/docs
VELCLAW_ALLOWED_ORIGINS=https://velclaw.app,https://www.velclaw.app,https://host.velclaw.app

# Runtime publisher / self-hosted deployment
VELCLAW_PUBLIC_DOMAIN=velclaw.app
VELCLAW_PUBLIC_SCHEME=https
VELCLAW_TLS_EMAIL=

# Required application secrets
VELCLAW_OAUTH_SECRET=
POSTGRES_URL=
JWE_SECRET=
ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_AGENTS_MODEL=gpt-4.1-mini

# S3-compatible storage. Generate credentials in the storage provider; never commit them.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# MCP server credentials (never commit real values)
GITHUB_MCP_PAT=
CONTEXT7_API_KEY=
RECALL_PRIVATE_KEY=
RECALL_NETWORK=testnet
RECALL_BUCKET_ALIAS=sequential-thinking-logs
RECALL_LOG_PREFIX=sequential-
