<style>
  :root {
    --ink: #14171a;
    --paper: #f6f5f2;
    --line: #dcd9d2;
    --claw: #c4432b;
    --claw-dark: #9c3220;
    --ok: #2f6b4f;
    --muted: #5c6065;
    --muted-2: #8b8f93;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
    font-family: 'IBM Plex Sans', 'Segoe UI', -apple-system, sans-serif;
  }
  input, select, button { font-family: inherit; }
  input:focus, select:focus, button:focus-visible {
    outline: 2px solid var(--claw);
    outline-offset: 2px;
  }
  header {
    border-bottom: 2px solid var(--ink);
    padding: 22px 24px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  .logo {
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .logo span { color: var(--claw); }
  .tagline {
    font-size: 12.5px;
    color: var(--muted);
    font-family: 'IBM Plex Mono', monospace;
  }
  main {
    max-width: 620px;
    margin: 0 auto;
    padding: 36px 24px 80px;
  }
  section { margin-bottom: 32px; }
  .step-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .step-num {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    background: var(--ink);
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  h2 { font-size: 17px; font-weight: 600; margin: 0; }
  p.desc {
    font-size: 13.5px;
    color: var(--muted);
    margin: 6px 0 14px;
    line-height: 1.5;
  }
  .row { display: flex; gap: 8px; }
  .vc-field {
    width: 100%;
    padding: 12px 14px;
    border: 1.5px solid var(--line);
    background: #fff;
    font-size: 14px;
    color: var(--ink);
  }
  .vc-field:focus { border-color: var(--ink); }
  label.field-label {
    display: block;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .vc-btn {
    cursor: pointer;
    border: 1.5px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    padding: 12px 20px;
    font-weight: 600;
    font-size: 14px;
    transition: transform .08s ease, background .15s ease;
    flex-shrink: 0;
  }
  .vc-btn:hover:not(:disabled) { background: #2a2e33; }
  .vc-btn:active:not(:disabled) { transform: translateY(1px); }
  .vc-btn:disabled { opacity: .45; cursor: not-allowed; }
  .vc-btn-claw { background: var(--claw); border-color: var(--claw); width: 100%; margin-top: 20px; }
  .vc-btn-claw:hover:not(:disabled) { background: var(--claw-dark); }
  .status-ok {
    margin-top: 12px;
    font-size: 13px;
    color: var(--ok);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--ok);
    display: inline-block;
  }
  .banner {
    border: 1.5px solid var(--claw);
    background: #fbeae6;
    color: var(--claw-dark);
    padding: 12px 14px;
    font-size: 13.5px;
    margin-bottom: 28px;
  }
  .banner.ok {
    border-color: var(--ok);
    background: #eaf4ee;
    color: var(--ok);
  }
  #step2 { opacity: 0.4; pointer-events: none; }
  #step2.active { opacity: 1; pointer-events: auto; }
  .or-sep {
    margin: 10px 0;
    font-size: 12.5px;
    color: var(--muted-2);
    text-align: center;
  }
  .mt14 { margin-top: 14px; }
  #result { margin-top: 14px; padding: 12px 14px; font-size: 13.5px; display: none; }
  #result.ok { border: 1.5px solid var(--ok); background: #eaf4ee; color: var(--ok); display: block; }
  #result.err { border: 1.5px solid var(--claw); background: #fbeae6; color: var(--claw-dark); display: block; }
</style>
