<script>
  let token = "";
  let teamId = "";
  let projects = [];
  let domains = [];

  const $ = (id) => document.getElementById(id);

  function authHeaders() {
    return {
      "Authorization": "Bearer " + token.trim(),
      "Content-Type": "application/json"
    };
  }

  function showError(msg) {
    const el = $("errorBanner");
    el.textContent = msg;
    el.style.display = "block";
  }
  function clearError() {
    $("errorBanner").style.display = "none";
  }

  function populateSelect(selectEl, items, placeholder) {
    selectEl.innerHTML = "";
    const opt0 = document.createElement("option");
    opt0.value = "";
    opt0.textContent = placeholder;
    selectEl.appendChild(opt0);
    items.forEach(item => {
      const opt = document.createElement("option");
      opt.value = item.value;
      opt.textContent = item.label;
      selectEl.appendChild(opt);
    });
  }

  async function fetchProjectsAndDomains(tid) {
    const qs = tid ? ("?teamId=" + tid) : "";
    const [projRes, domRes] = await Promise.all([
      fetch("https://api.vercel.com/v9/projects" + qs, { headers: authHeaders() }).then(r => r.json()),
      fetch("https://api.vercel.com/v5/domains" + qs, { headers: authHeaders() }).then(r => r.json()),
    ]);
    projects = projRes.projects || [];
    domains = domRes.domains || [];
    populateSelect($("projectSelect"), projects.map(p => ({ value: p.id, label: p.name })), "— chọn project —");
    populateSelect($("domainSelect"), domains.map(d => ({ value: d.name, label: d.name })), "— chọn domain —");
    $("connStatusText").textContent = "Đã kết nối — " + projects.length + " project, " + domains.length + " domain.";
  }

  $("connectBtn").addEventListener("click", async () => {
    token = $("token").value;
    if (!token.trim()) return;
    clearError();
    $("connStatus").style.display = "none";
    $("connectBtn").disabled = true;
    $("connectBtn").textContent = "Đang kết nối…";
    try {
      const me = await fetch("https://api.vercel.com/v2/user", { headers: authHeaders() });
      const meData = await me.json();
      if (!me.ok) throw new Error((meData.error && meData.error.message) || "Token không hợp lệ");

      let teamList = [];
      try {
        const teamsRes = await fetch("https://api.vercel.com/v2/teams", { headers: authHeaders() });
        const teamsData = await teamsRes.json();
        if (teamsRes.ok) teamList = teamsData.teams || [];
      } catch (_) {}

      teamId = teamList[0] ? teamList[0].id : "";

      if (teamList.length > 0) {
        $("teamPicker").style.display = "block";
        const sel = $("teamSelect");
        sel.innerHTML = "";
        const personalOpt = document.createElement("option");
        personalOpt.value = "";
        personalOpt.textContent = "Tài khoản cá nhân";
        sel.appendChild(personalOpt);
        teamList.forEach(t => {
          const opt = document.createElement("option");
          opt.value = t.id;
          opt.textContent = t.name || t.slug;
          sel.appendChild(opt);
        });
        sel.value = teamId;
      } else {
        $("teamPicker").style.display = "none";
      }

      await fetchProjectsAndDomains(teamId);

      $("connStatus").style.display = "flex";
      $("step2").classList.add("active");
      $("connectBtn").textContent = "Kết nối lại";
    } catch (e) {
      showError(e.message || "Không kết nối được với Vercel.");
      $("connectBtn").textContent = "Kết nối";
    } finally {
      $("connectBtn").disabled = false;
    }
  });

  $("teamSelect").addEventListener("change", async (e) => {
    teamId = e.target.value;
    clearError();
    try {
      await fetchProjectsAndDomains(teamId);
      $("customDomain").value = "";
    } catch (err) {
      showError(err.message || "Không tải được dữ liệu.");
    }
  });

  function updateAttachBtnState() {
    const proj = $("projectSelect").value;
    const dom = $("domainSelect").value;
    const custom = $("customDomain").value.trim();
    $("attachBtn").disabled = !(proj && (dom || custom));
  }
  $("projectSelect").addEventListener("change", updateAttachBtnState);
  $("domainSelect").addEventListener("change", () => {
    if ($("domainSelect").value) $("customDomain").value = "";
    updateAttachBtnState();
  });
  $("customDomain").addEventListener("input", () => {
    if ($("customDomain").value.trim()) $("domainSelect").value = "";
    updateAttachBtnState();
  });

  $("attachBtn").addEventListener("click", async () => {
    const projectId = $("projectSelect").value;
    const domainName = $("customDomain").value.trim() || $("domainSelect").value;
    if (!projectId || !domainName) return;

    const resultEl = $("result");
    resultEl.className = "";
    resultEl.style.display = "none";
    $("attachBtn").disabled = true;
    $("attachBtn").textContent = "Đang gắn…";

    try {
      const qs = teamId ? ("?teamId=" + teamId) : "";
      const res = await fetch("https://api.vercel.com/v10/projects/" + projectId + "/domains" + qs, {
        method: "POST",
        headers: authHeaders(),
        body: JSON.stringify({ name: domainName })
      });
      const data = await res.json();
      if (!res.ok) throw new Error((data.error && data.error.message) || "Gắn domain thất bại.");
      resultEl.textContent = "Đã gắn " + domainName + " vào project thành công.";
      resultEl.className = "ok";
    } catch (e) {
      resultEl.textContent = e.message || "Có lỗi xảy ra.";
      resultEl.className = "err";
    } finally {
      $("attachBtn").textContent = "Gắn domain vào project";
      updateAttachBtnState();
    }
  });
</script>

</body>
