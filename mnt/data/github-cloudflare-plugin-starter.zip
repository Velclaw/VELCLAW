"""
}
os.makedirs(base, exist_ok=True)
for rel, content in files.items():
    path=os.path.join(base, rel)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path,"w",encoding="utf-8") as f: f.write(textwrap.dedent(content).lstrip())
zip_path="/mnt/data/github-cloudflare-plugin-starter.zip"
with zipfile.ZipFile(zip_path,"w",zipfile.ZIP_DEFLATED) as z:
    for root,dirs,fs in os.walk(base):
        for fn in fs:
            p=os.path.join(root,fn)
            z.write(p, os.path.relpath(p, base))
print(f"Đã tạo bộ khung: {zip_path}\nSố tệp: {sum(len(fs) for _,_,fs in os.walk(base))}")
