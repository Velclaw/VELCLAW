{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build",
  "redirects": [
    {
      "source": "/OCodejs",
      "destination": "/OCodejs/",
      "permanent": true
    },
    {
      "source": "/docs.velclaw.ai",
      "destination": "/docs.velclaw.ai/",
      "permanent": true
    },
    {
      "source": "/docs-ocodejs",
      "destination": "/docs-ocodejs/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/OCodejs/(.*)",
      "destination": "https://ask-ocodejs.vercel.app/OCodejs/$1"
    },
    {
      "source": "/docs.velclaw.ai",
      "destination": "/docs"
    },
    {
      "source": "/docs.velclaw.ai/(.*)",
      "destination": "/docs/$1"
    },
    {
      "source": "/docs-ocodejs",
      "destination": "https://ocodejs-docs.vercel.app/"
    },
    {
      "source": "/docs-ocodejs/(.*)",
      "destination": "https://ocodejs-docs.vercel.app/$1"
    },
    {
      "source": "/api/(.*)",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": ".*/OCodejs.*"
        }
      ],
      "destination": "https://ask-ocodejs.vercel.app/api/$1"
    },
    {
      "source": "/v1/chat",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": ".*/OCodejs.*"
        }
      ],
      "destination": "https://ask-ocodejs.vercel.app/v1/chat"
    },
    {
      "source": "/chat",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": ".*/OCodejs.*"
        }
      ],
      "destination": "https://ask-ocodejs.vercel.app/chat"
    },
    {
      "source": "/health",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": ".*/OCodejs.*"
        }
      ],
      "destination": "https://ask-ocodejs.vercel.app/health"
    }
  ]
}
