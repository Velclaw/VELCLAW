{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "installCommand": "pnpm install --no-frozen-lockfile"
    },
    "agentside": {
      "root": "AgentsIDE",
      "framework": "vite",
      "installCommand": "pnpm install --no-frozen-lockfile --prod=false"
    },
    "autoship": {
      "root": "Autoship",
      "framework": "vite",
      "installCommand": "pnpm install --no-frozen-lockfile"
    },
    "docs": {
      "root": ".",
      "framework": "vite",
      "installCommand": "pnpm install --no-frozen-lockfile",
      "buildCommand": "pip install -r docs/requirements.txt && mkdocs build",
      "outputDirectory": "site"
    },
    "kio": {
      "root": "KIO",
      "runtime": "node",
      "entrypoint": "server.js",
      "installCommand": "pnpm install --no-frozen-lockfile"
    },
    "velclaw": {
      "root": "Velclaw",
      "framework": "nextjs",
      "installCommand": "pnpm install --no-frozen-lockfile"
    },
    "velclaw-docs": {
      "root": "velclaw-docs",
      "framework": "vite",
      "installCommand": "pnpm install --no-frozen-lockfile"
    },
    "velclaw-pages": {
      "root": "velclaw-pages",
      "runtime": "node",
      "entrypoint": "server.js",
      "installCommand": "pnpm install --no-frozen-lockfile"
    },
    "zskai": {
      "root": "ZsKai",
      "framework": "vite",
      "installCommand": "pnpm install --no-frozen-lockfile"
    },
    "zvelclaw": {
      "root": "Zvelclaw",
      "runtime": "container",
      "installCommand": "pnpm install --no-frozen-lockfile"
    }
  },
  "rewrites": [
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
