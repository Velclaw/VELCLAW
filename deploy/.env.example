# Velclaw Deploy self-hosted runtime
# Supabase: Dashboard -> Connect -> Connection string -> Session pooler.
# Put the Supabase pooled PostgreSQL URI here; do not commit real credentials.
POSTGRES_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
VELCLAW_DEPLOY_API=http://velclaw-control-plane:3000
VELCLAW_DEPLOY_API_TOKEN=generate-a-long-random-token
VELCLAW_PUBLIC_HOST=velclaw.cfd
VELCLAW_PUBLIC_DOMAIN=velclaw.cfd
VELCLAW_TLS_EMAIL=ops@velclaw.cfd
VELCLAW_DEPLOY_POLL_MS=3000
