# Velclaw Hosting / Deploy self-hosted runtime
# PostgreSQL can be supplied by a free-tier provider such as Supabase.
# Put the PostgreSQL connection URI here; do not commit real credentials.
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Velclaw control plane + deployment worker
VELCLAW_DEPLOY_API=http://velclaw-control-plane:3000
VELCLAW_DEPLOY_API_TOKEN=generate-a-long-random-token
VELCLAW_DEPLOY_POLL_MS=3000

# First-party public hosting namespace
VELCLAW_PUBLIC_HOST=velclaw.cfd
VELCLAW_PUBLIC_DOMAIN=velclaw.cfd
VELCLAW_PUBLIC_SCHEME=https
VELCLAW_TRAEFIK_ENTRYPOINT=websecure
VELCLAW_TLS_ENABLED=true
VELCLAW_TLS_EMAIL=ops@velclaw.cfd

# GitHub token used by the publisher to clone deployment sources.
# Use a least-privilege token suitable for the repositories Velclaw should deploy.
GITHUB_TOKEN=replace-with-github-token

# Optional AI/runtime integrations are intentionally not required by Velclaw Hosting.
# Keep paid-provider credentials out of the hosting deployment configuration.
