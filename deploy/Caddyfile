{$VELCLAW_PUBLIC_HOST:deploy.velclaw.cfd} {
  reverse_proxy velclaw-control-plane:3000
}

*.{$VELCLAW_PUBLIC_DOMAIN:velclaw.cfd} {
  @deployment host_regexp deployment ^(?P<project>[a-z0-9][a-z0-9-]{0,62})-(?P<id>[a-f0-9]{8})\.{$VELCLAW_PUBLIC_DOMAIN:velclaw.cfd}$
  handle @deployment {
    reverse_proxy {$VELCLAW_RUNTIME_TARGET:velclaw-runtime-router:8080}
  }
  respond 404
}
