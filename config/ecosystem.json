{
  "schemaVersion": 1,
  "ecosystem": "Velclaw",
  "hub": {
    "repository": "Velclaw/VELCLAW",
    "role": "product-workspace",
    "status": "hub-candidate"
  },
  "policy": {
    "repositoryStrategy": "keep-repositories-separate",
    "secretsInGit": false,
    "autoConnectUnreviewedRepositories": false,
    "requireAuthenticatedContractAndHealthCheck": true
  },
  "domainDecision": {
    "status": "needs-reconciliation-before-DNS-changes",
    "currentCodeRoles": {
      "velclaw.site": "platform",
      "velclaw.dev": "developer",
      "velclaw.app": "application"
    },
    "conflictingStatement": "The core README also describes velclaw.app as the temporary canonical first-party domain.",
    "note": "Treat these as product-domain roles, not proof of live DNS/HTTPS. Do not change DNS, redirects, or OAuth callbacks until intended roles and reachability are verified."
  },
